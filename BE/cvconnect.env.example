# CVConnect backend environment template
# This file is used by BE/docker-compose.app.yml
# Values below are set for local Docker execution.

ENVIRONMENT=dev

# Service-to-service hosts and ports (inside Docker network)
HOST_USER_SERVICE=user-service-cvconnect
PORT_USER_SERVICE=8180
HOST_NOTIFY_SERVICE=notify-service-cvconnect
PORT_NOTIFY_SERVICE=8181
HOST_CORE_SERVICE=core-service-cvconnect
PORT_CORE_SERVICE=8182
HOST_SOCKET=notify-service-cvconnect
PORT_SOCKET=9090

# Infrastructure hosts
DB_MYSQL_HOST=mysql
DB_POSTGRES_HOST=postgres
REDIS_HOST=redis
COLLECTION_HOST=mongo
KAFKA_HOST=kafka
KAFKA_PORT=9092

# External URLs
FRONTEND_URL=http://localhost:3000
BE_URL=http://localhost:8888
MAIL_ADMIN=nnmhqn2003@gmail.com

# OAuth
GOOGLE_CLIENT_ID=1
GOOGLE_CLIENT_SECRET=1

# JWT
EXPIRATION=86400
REFRESH_EXPIRATION=604800
VERIFY_EXPIRATION=172800
RESET_PASSWORD_EXPIRATION=3600
SECRET_KEY=TaqlmGv1iEDMRiFp/pHuID1+T84IABfuA0xXh4GhiUI=
SECRET_INTERNAL=LmJHf7e5q3k8nPz9u2y4rXw6vT1sQ0aC3eFhJgKpR0tY=

# Optional integrations
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SPRING_JPA_HIBERNATE_DDL_AUTO=update
